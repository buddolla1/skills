{
  "name": "React ADA Accessibility Remediation Agent",
  "id": "react-ada-fixer",
  "description": "Processes ADA accessibility reports and recommends or applies WCAG-aligned fixes to React code. Supports raw JSX/TSX input and text extracted from Word documents.",
  "version": "2.0.0",
  "type": "processor",
  "input": {
    "type": "object",
    "properties": {
      "sourceDocument": {
        "type": "object",
        "description": "Optional Word document input for source code or analysis text. Provide a local file path, extracted text, or base64-encoded binary content. Enable OCR or image extraction when the document contains meaningful visual content.",
        "oneOf": [
          {
            "required": ["filePath"],
            "not": {
              "anyOf": [
                { "required": ["content"] },
                { "required": ["contentBase64"] },
                { "required": ["extractedText"] }
              ]
            }
          },
          {
            "required": ["content"],
            "not": {
              "anyOf": [
                { "required": ["filePath"] },
                { "required": ["contentBase64"] },
                { "required": ["extractedText"] }
              ]
            }
          },
          {
            "required": ["contentBase64"],
            "not": {
              "anyOf": [
                { "required": ["filePath"] },
                { "required": ["content"] },
                { "required": ["extractedText"] }
              ]
            }
          },
          {
            "required": ["extractedText"],
            "not": {
              "anyOf": [
                { "required": ["filePath"] },
                { "required": ["content"] },
                { "required": ["contentBase64"] }
              ]
            }
          }
        ],
        "properties": {
          "fileName": {
            "type": "string",
            "description": "Original Word document name, for example `report.docx`"
          },
          "filePath": {
            "type": "string",
            "description": "Local filesystem path to the Word document"
          },
          "mimeType": {
            "type": "string",
            "enum": ["application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/msword"],
            "description": "Word document MIME type"
          },
          "content": {
            "type": "string",
            "description": "Plain text extracted from the Word document"
          },
          "extractedText": {
            "type": "string",
            "description": "Full text extracted from the Word document before processing"
          },
          "contentBase64": {
            "type": "string",
            "description": "Base64-encoded Word document bytes for direct binary upload"
          },
          "extractImages": {
            "type": "boolean",
            "description": "Whether to extract embedded images from the Word document for separate analysis",
            "default": false
          },
          "enableOCR": {
            "type": "boolean",
            "description": "Whether to run OCR on extracted images or image-only regions in the Word document",
            "default": false
          },
          "imageAssets": {
            "type": "array",
            "description": "Optional extracted image assets supplied separately for OCR or visual analysis",
            "items": {
              "type": "object",
              "properties": {
                "fileName": {
                  "type": "string",
                  "description": "Image file name"
                },
                "mimeType": {
                  "type": "string",
                  "description": "Image MIME type, such as `image/png` or `image/jpeg`"
                },
                "contentBase64": {
                  "type": "string",
                  "description": "Base64-encoded image bytes"
                },
                "altText": {
                  "type": "string",
                  "description": "Optional OCR or user-provided description of the image"
                }
              }
            }
          }
        }
      },
      "fileContent": {
        "type": "string",
        "description": "Original React JSX/TSX code"
      },
      "adaReport": {
        "type": "object",
        "description": "Accessibility report generated by the analyzer agent",
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "severity": { "type": "string" },
                "line": { "type": "number" },
                "description": { "type": "string" },
                "wcagReference": { "type": "string" },
                "suggestion": { "type": "string" }
              }
            }
          }
        }
      },
      "fixMode": {
        "type": "string",
        "enum": ["suggest_only", "auto_fix"],
        "default": "suggest_only"
      }
    },
    "required": ["adaReport"],
    "anyOf": [
      { "required": ["fileContent"] },
      { "required": ["sourceDocument"] }
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "fixSummary": {
        "type": "string",
        "description": "Concise summary of the applied or recommended fixes"
      },
      "fixes": {
        "type": "array",
        "description": "Structured list of individual accessibility fixes",
        "items": {
          "type": "object",
          "properties": {
            "issueType": { "type": "string", "description": "Accessibility issue category" },
            "line": { "type": "number", "description": "Affected line number, when available" },
            "originalCode": { "type": "string", "description": "Original code fragment" },
            "fixedCode": { "type": "string", "description": "Updated code fragment" },
            "explanation": { "type": "string", "description": "Reason the fix was applied" }
          }
        }
      },
      "updatedCode": {
        "type": "string",
        "description": "Complete updated source code"
      },
      "diff": {
        "type": "string",
        "description": "Unified diff showing the applied changes"
      },
      "reportFile": {
        "type": "string",
        "description": "Path to the generated Markdown report file containing the findings"
      }
    }
  },
  "workflow": [
      {
        "step": "Parse ADA report",
        "action": "Extract issues and map them to fix strategies"
      },
      {
        "step": "Normalize source input",
        "action": "Resolve source input from `fileContent`, `sourceDocument.extractedText`, `sourceDocument.filePath`, `sourceDocument.contentBase64`, or `sourceDocument.content` before processing"
      },
      {
        "step": "Handle document images",
        "action": "If enabled, extract embedded images and analyze OCR output or `imageAssets` before generating findings"
      },
      {
        "step": "Locate code segments",
        "action": "Identify affected lines and components in the JSX"
      },
      {
        "step": "Apply fix rules",
        "action": "Transform code using WCAG-compliant patterns"
      },
      {
        "step": "Generate updated code",
        "action": "Return modified JSX when `fixMode` is set to `auto_fix`"
      },
      {
        "step": "Generate report",
        "action": "Write the findings, fixes, and disposition into `docs/report.md` when `fixMode` is `suggest_only`"
      },
      {
        "step": "Explain fixes",
        "action": "Provide concise reasoning for each fix"
      }
    ],
  "skills": [
    "ada-report-parser",
    "jsx-locator",
    "wcag-fix-engine",
    "aria-enhancer",
    "semantic-html-transformer",
    "keyboard-accessibility-fixer",
    "form-label-fixer",
    "image-alt-fixer",
    "diff-generator"
  ],
  "fixStrategies": {
    "image-alt-missing": {
      "fix": "Add alt attribute",
      "template": "<img src=\"{src}\" alt=\"{description}\" />"
    },
    "button-name-missing": {
      "fix": "Add accessible label",
      "template": "<button aria-label=\"{label}\">{content}</button>"
    },
    "clickable-div": {
      "fix": "Replace div with button",
      "template": "<button onClick={handler}>{content}</button>"
    },
    "input-label-missing": {
      "fix": "Add label element",
      "template": "<label>{label}<input {...props} /></label>"
    },
    "aria-role-invalid": {
      "fix": "Remove or correct ARIA role",
      "template": "Use semantic HTML instead"
    }
  },
  "rules": [
    "Prefer semantic HTML over ARIA where possible",
    "Preserve existing behavior",
    "Maintain keyboard accessibility",
    "Preserve developer intent and UI semantics",
    "Add only the attributes required to address the issue",
    "Avoid unnecessary use of aria-* attributes"
  ],
  "interactions": [
    {
      "question": "Should fixes be applied automatically?",
      "options": ["yes", "no"]
    },
    {
      "question": "Should fixes prioritize minimal change or strict WCAG compliance?",
      "options": ["minimal", "strict"]
    }
  ],
  "examples": [
    {
      "input": {
        "fileContent": "<div onClick={submit}>Submit</div>",
        "adaReport": {
          "issues": [
            {
              "type": "clickable-div",
              "line": 1,
              "description": "Not keyboard accessible"
            }
          ]
        }
      },
      "output": {
        "fixes": [
          {
            "issueType": "clickable-div",
            "fixedCode": "<button onClick={submit}>Submit</button>"
          }
        ],
        "reportFile": "docs/report.md"
      }
    },
    {
      "input": {
        "sourceDocument": {
          "fileName": "review-notes.docx",
          "filePath": "/Users/maheswarbuddolla/softwares/skills3/docs/review-notes.docx",
          "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "content": "<div onClick={submit}>Submit</div>",
          "extractImages": true,
          "enableOCR": true,
          "imageAssets": [
            {
              "fileName": "diagram.png",
              "mimeType": "image/png",
              "contentBase64": "iVBORw0KGgoAAAANSUhEUgAA...",
              "altText": "Flow diagram showing review steps"
            }
          ]
        },
        "adaReport": {
          "issues": [
            {
              "type": "clickable-div",
              "line": 1,
              "description": "Not keyboard accessible"
            }
          ]
        }
      },
      "output": {
        "fixes": [
          {
            "issueType": "clickable-div",
            "fixedCode": "<button onClick={submit}>Submit</button>"
          }
        ],
        "reportFile": "docs/report.md"
      }
    },
    {
      "input": {
        "sourceDocument": {
          "fileName": "review-notes.docx",
          "filePath": "/Users/maheswarbuddolla/softwares/skills3/docs/review-notes.docx",
          "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "contentBase64": "UEsDBBQAAAAIA...",
          "extractImages": true,
          "enableOCR": true
        },
        "adaReport": {
          "issues": [
            {
              "type": "clickable-div",
              "line": 1,
              "description": "Not keyboard accessible"
            }
          ]
        }
      },
      "output": {
        "fixes": [
          {
            "issueType": "clickable-div",
            "fixedCode": "<button onClick={submit}>Submit</button>"
          }
        ],
        "reportFile": "docs/report.md"
      }
    }
  ]
}
